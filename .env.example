# Speech-to-text: https://console.deepgram.com
DEEPGRAM_API_KEY=

# LLM: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Text-to-speech: https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Any voice ID from https://play.cartesia.ai/voices
CARTESIA_VOICE_ID=

# Turn-taking: seconds of silence before VAD says the user stopped
VAD_STOP_SECS=0.2
